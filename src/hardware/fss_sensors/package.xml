  <version>0.2.0</version>
  <description>FSS 센서 래퍼: FSS_VICON UDP 브릿지 + Xsens MTi-630 IMU 브릿지</description>
  <maintainer email="iyeons127@snu.ac.kr">smong_jetson</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
