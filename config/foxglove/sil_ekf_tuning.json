  "userNodes": {
    "8f0c2d42-f88a-4af6-9f5d-4d51a7426633": {
      "name": "FSS Derived Metrics",
      "sourceCode": "import { Input } from \"./types.ts\";\n\ntype State = { x: number; y: number; theta: number };\ntype Reference = { x_ref: number; y_ref: number; theta_ref: number };\ntype Output = {\n  estimation_position_error: number;\n  estimation_heading_error_deg: number;\n  tracking_position_error: number;\n  tracking_heading_error_deg: number;\n};\n\nexport const inputs = [\n  \"/navigation/state\",\n  \"/sim/true_state\",\n  \"/gnc/trajectory_ref\",\n];\nexport const output = \"/fss/derived/metrics\";\n\nlet truth: State | undefined;\nlet reference: Reference | undefined;\n\nfunction wrapAngle(value: number): number {\n  return ((value + Math.PI) % (2 * Math.PI) + 2 * Math.PI) % (2 * Math.PI) - Math.PI;\n}\n\nexport default function script(\n  event:\n    | Input<\"/navigation/state\">\n    | Input<\"/sim/true_state\">\n    | Input<\"/gnc/trajectory_ref\">,\n): Output | undefined {\n  if (event.topic === \"/sim/true_state\") {\n    truth = event.message;\n    return;\n  }\n  if (event.topic === \"/gnc/trajectory_ref\") {\n    reference = event.message;\n    return;\n  }\n  if (truth == undefined || reference == undefined) {\n    return;\n  }\n\n  const nav = event.message;\n  return {\n    estimation_position_error: Math.hypot(nav.x - truth.x, nav.y - truth.y),\n    estimation_heading_error_deg:\n      wrapAngle(nav.theta - truth.theta) * 180 / Math.PI,\n    tracking_position_error:\n      Math.hypot(truth.x - reference.x_ref, truth.y - reference.y_ref),\n    tracking_heading_error_deg:\n      wrapAngle(truth.theta - reference.theta_ref) * 180 / Math.PI,\n  };\n}\n"
    }
  },
